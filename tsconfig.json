{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUnusedLocals": false,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src"]
}
